ps1rename () {
    if [[ $1 == 'bw' ]]; then
        export PS1="\t [${@:2}]\\$ "
        # unalias colorful aliases
        unalias ls grep egrep fgrep diff 2>/dev/null
    else 
        export PS1="${lred}\t${def} ${lblu}[${@}]${def}\\$ "
    fi
}

export PAGER=less
export SYSTEMD_PAGER=less
export HISTSIZE=10000
export HISTFILESIZE=10000
# Turn off beep
if which xset >/dev/null 2>&1 && [[ $DISPLAY ]]; then
    xset b off
fi

# Fix lines
shopt -s checkwinsize

# Bash Color Variables
cb='\[\033['; ce='\]'; def="${cb}0m${ce}"
blk="${cb}30m${ce}" ; red="${cb}31m${ce}"
grn="${cb}33m${ce}"; ylw="${cb}33m${ce}"
blu="${cb}34m${ce}"; mag="${cb}35m${ce}"
cyn="${cb}36m${ce}"; gry="${cb}37m${ce}"
lred="${cb}91m${ce}"; lgrn="${cb}92m${ce}"
lylw="${cb}93m${ce}"; lblu="${cb}94m${ce}"
lmag="${cb}95m${ce}"; lcyn="${cb}96m${ce}"
lgry="${cb}97m${ce}"
export PS1="${lred}\t${def} ${cyn}\h${def}:${lblu}\w${def}\\$ "

if [[ -f $HOME/.mypath ]]; then
    source $HOME/.mypath
else
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:~/bin
fi

alias ls='ls --color=auto'
alias l='ls'
alias ls.='ls -a'
alias ll='ls -l'
alias l.='ls -d .*'
alias lt='ls -ltr'
alias ll.='ls -la'
alias lt.='ls -latr'

## get rid of command not found ##
alias cd..='cd ..'

## a quick way to get out of current directory ##
alias ..='cd ..'
alias ...='cd ../../../'
alias ....='cd ../../../../'
alias .....='cd ../../../../'
alias .4='cd ../../../../'
alias .5='cd ../../../../..'

## Colorize the grep command output for ease of use (good for log files)##
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'

# Calculator with math support
alias bc='bc -l'

# sha1
alias sha1='openssl sha1'

# Auto-create parent directories
alias mkdir='mkdir -pv'

# install  colordiff package :)
if which colordiff >/dev/null 2>&1; then
    alias diff='colordiff'
fi

# handy short cuts #
alias h='history'
alias j='jobs -l'

# Print current PATH
alias path='echo -e ${PATH//:/\\n}'

# date stuff
alias now='date +"%T"'
alias nowtime=now
alias nowdate='date +"%d-%m-%Y"'
alias epoch='date +%s'

# ViMproved
alias vi=vim
alias vis='vim "+set si"'
alias edit='vim'

# Get open ports
alias ports='netstat -tulanp'

# get web server headers #
alias header='curl -I'

# find out if remote server supports gzip / mod_deflate or not #
alias headerc='curl -I --compress'

# do not delete / or prompt if deleting more than 3 files at a time #
alias rm='rm -I --preserve-root'

# Preventing changing perms on / #
alias chown='chown --preserve-root'
alias chmod='chmod --preserve-root'
alias chgrp='chgrp --preserve-root'

## pass options to free ##
alias meminfo='free -m -l -t'

## get top process eating memory
alias psmem='ps auxf | sort -nr -k 4'
alias psmem10='ps auxf | sort -nr -k 4 | head -10'

## get top process eating cpu ##
alias pscpu='ps auxf | sort -nr -k 3'
alias pscpu10='ps auxf | sort -nr -k 3 | head -10'

## Get server cpu info ##
alias cpuinfo='lscpu'

## this one saved by butt so many times -- auto-resume wget! ##
alias wget='wget -c'

## set some other defaults ##
alias df='df -H'
alias du='du -ch'

# top is atop, just like vi is vim
alias top='htop'

# Docker
alias dockerclean="docker ps -a | grep Exited | grep -oP '^[a-z0-9]{12}' | xargs docker rm"
